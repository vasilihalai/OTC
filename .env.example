# Base URL of the real exchange API (profile, balances, withdrawals, transfers).
# Only used when VITE_USE_REAL_API=true.
VITE_API_BASE_URL=

# Personal (xruby.kg) and business (business.xruby.kg) accounts authenticate
# against two different backends — per miniapp-auth-integration-spec.md §3.1,
# each side's Mini App is its own public OAuth client on its own auth-service
# deployment. Only used when VITE_USE_REAL_API=true.
VITE_API_BASE_URL_PERSONAL=
VITE_API_BASE_URL_BUSINESS=
VITE_MINI_APP_CLIENT_ID_PERSONAL=
VITE_MINI_APP_CLIENT_ID_BUSINESS=

# Master switch: false/unset (default) runs entirely on mocks — auth, profile,
# balances, and withdrawals all resolve from src/api/mock/*. Set to true once
# the real endpoints in src/api/real/* (assumed contracts — reconcile against
# Swagger when available) are ready to hit. Deals and home stats stay mocked
# either way.
VITE_USE_REAL_API=false

# Forces the in-app AppHeader pill (close/back) to render even inside real
# Telegram, where it's normally hidden in favor of the native BackButton.
# Useful for demos and design review.
VITE_FORCE_INAPP_HEADER=false
